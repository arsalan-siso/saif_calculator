// دالة لتحويل النص إلى عدد
عدد تحويل_نص_الى_عدد(محرف *نص) {
    عدد ن = 0;
    عدد ع = 0;
    طالما (نص[ع] != '\0' و نص[ع] != '.') {
        ن = ن * 10 + (نص[ع] - '0');
        ع++;
    }
    ارجع ن;
}

// دالة للتحقق من النقر داخل مستطيل
عدد هل_نقر(مستطيل زر, عدد س, عدد ص) {
    اذا (س >= زر.x و س <= زر.x + زر.w و ص >= زر.y و ص <= زر.y + زر.h) {
        ارجع 1;
    }
    ارجع 0;
}

// دالة لرسم نص على زر
عدم ارسم_نص_على_زر(راسم *رس, خط *خ, محرف *نص, مستطيل زر, لون ل) {
    سطح *سطح = ارسم_نص_عربي(خ, نص, ل);
    نسيج *نس = حول_سطح_الى_نسيج(رس, سطح);
    
    // حساب منتصف الزر لوضع النص فيه
    عدد عرض_النص = طول_نص(نص) * 15; // تقديري
    مستطيل م;
    م.x = زر.x + (زر.w - عرض_النص) / 2;
    م.y = زر.y + (زر.h - 30) / 2;
    م.w = عرض_النص;
    م.h = 30;
    
    انسخ_النسيج(رس, نس, فارغ, &م);
    حرر_سطح(سطح);
    حرر_نسيج(نس);
}

عدد رئيسي() {
    // تهيئة الرسوميات والخط
    ابدأ_الرسوم();
    ابدأ_الخط();
    
    نافذة *نو = افتتح_نافذة("🧮 آلة حاسبة سيف", 400, 550);
    راسم *رس = افتتح_راسم(نو);
    
    // فتح خط عربي
    خط *خ = افتتح_خط_بحجم("/usr/share/fonts/truetype/arabeyes/ae_AlHor.ttf", 24);
    اذا (خ == فارغ) {
        خ = افتتح_خط_بحجم("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 24);
    }
    
    // متغيرات الحاسبة
    محرف نص_الشاشة[50];
    انسخ_نص(نص_الشاشة, "0");
    عدد الرقم_الأول = 0;
    عدد الرقم_الثاني = 0;
    عدد النتيجة = 0;
    عدد العملية = -1;
    عدد بداية_جديدة = 1;

    // تعريف الأزرار
    مستطيل زر_7 = {30, 180, 70, 50};
    مستطيل زر_8 = {110, 180, 70, 50};
    مستطيل زر_9 = {190, 180, 70, 50};
    مستطيل زر_قسمة = {270, 180, 70, 50};

    مستطيل زر_4 = {30, 240, 70, 50};
    مستطيل زر_5 = {110, 240, 70, 50};
    مستطيل زر_6 = {190, 240, 70, 50};
    مستطيل زر_ضرب = {270, 240, 70, 50};

    مستطيل زر_1 = {30, 300, 70, 50};
    مستطيل زر_2 = {110, 300, 70, 50};
    مستطيل زر_3 = {190, 300, 70, 50};
    مستطيل زر_طرح = {270, 300, 70, 50};

    مستطيل زر_0 = {30, 360, 70, 50};
    مستطيل زر_فاصلة = {110, 360, 70, 50};
    مستطيل زر_مسح = {190, 360, 70, 50};
    مستطيل زر_جمع = {270, 360, 70, 50};

    مستطيل زر_مساواة = {30, 420, 310, 60};

    // ألوان النصوص
    لون لون_ابيض = {255, 255, 255, 255};
    لون لون_اسود = {0, 0, 0, 255};

    عدد تشغيل = 1;

    طالما (تشغيل) {
        طالما (هل_حدث()) {
            اذا (هل_خروج()) {
                تشغيل = 0;
                توقف;
            }

            اذا (نوع_الحدث == حدث_فأرة) {
                عدد س_فأرة = موقع_الفأرة_س;
                عدد ص_فأرة = موقع_الفأرة_ص;

                // أرقام
                اذا (هل_نقر(زر_0, س_فأرة, ص_فأرة)) {
                    اذا (بداية_جديدة) { انسخ_نص(نص_الشاشة, "0"); بداية_جديدة = 0; }
                    والا ادمج_نص(نص_الشاشة, "0");
                }
                والا اذا (هل_نقر(زر_1, س_فأرة, ص_فأرة)) {
                    اذا (بداية_جديدة) { انسخ_نص(نص_الشاشة, "1"); بداية_جديدة = 0; }
                    والا ادمج_نص(نص_الشاشة, "1");
                }
                والا اذا (هل_نقر(زر_2, س_فأرة, ص_فأرة)) {
                    اذا (بداية_جديدة) { انسخ_نص(نص_الشاشة, "2"); بداية_جديدة = 0; }
                    والا ادمج_نص(نص_الشاشة, "2");
                }
                والا اذا (هل_نقر(زر_3, س_فأرة, ص_فأرة)) {
                    اذا (بداية_جديدة) { انسخ_نص(نص_الشاشة, "3"); بداية_جديدة = 0; }
                    والا ادمج_نص(نص_الشاشة, "3");
                }
                والا اذا (هل_نقر(زر_4, س_فأرة, ص_فأرة)) {
                    اذا (بداية_جديدة) { انسخ_نص(نص_الشاشة, "4"); بداية_جديدة = 0; }
                    والا ادمج_نص(نص_الشاشة, "4");
                }
                والا اذا (هل_نقر(زر_5, س_فأرة, ص_فأرة)) {
                    اذا (بداية_جديدة) { انسخ_نص(نص_الشاشة, "5"); بداية_جديدة = 0; }
                    والا ادمج_نص(نص_الشاشة, "5");
                }
                والا اذا (هل_نقر(زر_6, س_فأرة, ص_فأرة)) {
                    اذا (بداية_جديدة) { انسخ_نص(نص_الشاشة, "6"); بداية_جديدة = 0; }
                    والا ادمج_نص(نص_الشاشة, "6");
                }
                والا اذا (هل_نقر(زر_7, س_فأرة, ص_فأرة)) {
                    اذا (بداية_جديدة) { انسخ_نص(نص_الشاشة, "7"); بداية_جديدة = 0; }
                    والا ادمج_نص(نص_الشاشة, "7");
                }
                والا اذا (هل_نقر(زر_8, س_فأرة, ص_فأرة)) {
                    اذا (بداية_جديدة) { انسخ_نص(نص_الشاشة, "8"); بداية_جديدة = 0; }
                    والا ادمج_نص(نص_الشاشة, "8");
                }
                والا اذا (هل_نقر(زر_9, س_فأرة, ص_فأرة)) {
                    اذا (بداية_جديدة) { انسخ_نص(نص_الشاشة, "9"); بداية_جديدة = 0; }
                    والا ادمج_نص(نص_الشاشة, "9");
                }

                // فاصلة
                والا اذا (هل_نقر(زر_فاصلة, س_فأرة, ص_فأرة)) {
                    اذا (بداية_جديدة) { انسخ_نص(نص_الشاشة, "0."); بداية_جديدة = 0; }
                    والا اذا (بحث_نص(نص_الشاشة, ".") == فارغ) {
                        ادمج_نص(نص_الشاشة, ".");
                    }
                }

                // عمليات
                والا اذا (هل_نقر(زر_جمع, س_فأرة, ص_فأرة)) {
                    الرقم_الأول = تحويل_نص_الى_عدد(نص_الشاشة);
                    العملية = 0;
                    بداية_جديدة = 1;
                }
                والا اذا (هل_نقر(زر_طرح, س_فأرة, ص_فأرة)) {
                    الرقم_الأول = تحويل_نص_الى_عدد(نص_الشاشة);
                    العملية = 1;
                    بداية_جديدة = 1;
                }
                والا اذا (هل_نقر(زر_ضرب, س_فأرة, ص_فأرة)) {
                    الرقم_الأول = تحويل_نص_الى_عدد(نص_الشاشة);
                    العملية = 2;
                    بداية_جديدة = 1;
                }
                والا اذا (هل_نقر(زر_قسمة, س_فأرة, ص_فأرة)) {
                    الرقم_الأول = تحويل_نص_الى_عدد(نص_الشاشة);
                    العملية = 3;
                    بداية_جديدة = 1;
                }

                // مسح
                والا اذا (هل_نقر(زر_مسح, س_فأرة, ص_فأرة)) {
                    انسخ_نص(نص_الشاشة, "0");
                    الرقم_الأول = 0;
                    الرقم_الثاني = 0;
                    النتيجة = 0;
                    العملية = -1;
                    بداية_جديدة = 1;
                }

                // مساواة
                والا اذا (هل_نقر(زر_مساواة, س_فأرة, ص_فأرة) و العملية != -1) {
                    الرقم_الثاني = تحويل_نص_الى_عدد(نص_الشاشة);
                    اذا (العملية == 0) النتيجة = الرقم_الأول + الرقم_الثاني;
                    والا اذا (العملية == 1) النتيجة = الرقم_الأول - الرقم_الثاني;
                    والا اذا (العملية == 2) النتيجة = الرقم_الأول * الرقم_الثاني;
                    والا اذا (العملية == 3) {
                        اذا (الرقم_الثاني != 0) النتيجة = الرقم_الأول / الرقم_الثاني;
                        والا انسخ_نص(نص_الشاشة, "خطأ");
                    }
                    sprintf(نص_الشاشة, "%d", النتيجة);
                    الرقم_الأول = النتيجة;
                    العملية = -1;
                    بداية_جديدة = 1;
                }
            }
        }

        // الرسم
        استعمل_لون(رس, 30, 30, 50);
        امسح_اللوحة(رس);

        // شاشة العرض
        استعمل_لون(رس, 10, 10, 30);
        مستطيل شاشة = {20, 40, 360, 80};
        املأ_مستطيل(رس, &شاشة);
        
        // رسم الرقم على الشاشة (باستخدام الخط)
        اذا (خ != فارغ) {
            لون لون_شاشة = {0, 255, 100, 255};
            سطح *سطح_شاشة = ارسم_نص_عربي(خ, نص_الشاشة, لون_شاشة);
            نسيج *نسيج_شاشة = حول_سطح_الى_نسيج(رس, سطح_شاشة);
            
            عدد عرض_النص = طول_نص(نص_الشاشة) * 15;
            مستطيل م_شاشة;
            م_شاشة.x = 340 - عرض_النص;
            م_شاشة.y = 55;
            م_شاشة.w = عرض_النص;
            م_شاشة.h = 50;
            
            انسخ_النسيج(رس, نسيج_شاشة, فارغ, &م_شاشة);
            حرر_سطح(سطح_شاشة);
            حرر_نسيج(نسيج_شاشة);
        }

        // رسم الأزرار مع النصوص
        // أزرار الأرقام
        استعمل_لون(رس, 60, 60, 90);
        املأ_مستطيل(رس, &زر_7);
        املأ_مستطيل(رس, &زر_8);
        املأ_مستطيل(رس, &زر_9);
        املأ_مستطيل(رس, &زر_4);
        املأ_مستطيل(رس, &زر_5);
        املأ_مستطيل(رس, &زر_6);
        املأ_مستطيل(رس, &زر_1);
        املأ_مستطيل(رس, &زر_2);
        املأ_مستطيل(رس, &زر_3);
        املأ_مستطيل(رس, &زر_0);
        
        // أزرار العمليات
        استعمل_لون(رس, 200, 120, 50);
        املأ_مستطيل(رس, &زر_جمع);
        املأ_مستطيل(رس, &زر_طرح);
        املأ_مستطيل(رس, &زر_ضرب);
        املأ_مستطيل(رس, &زر_قسمة);
        
        // زر المسح
        استعمل_لون(رس, 200, 50, 50);
        املأ_مستطيل(رس, &زر_مسح);
        
        // زر المساواة
        استعمل_لون(رس, 50, 150, 200);
        املأ_مستطيل(رس, &زر_مساواة);

        // رسم النصوص على الأزرار
        اذا (خ != فارغ) {
            ارسم_نص_على_زر(رس, خ, "7", زر_7, لون_ابيض);
            ارسم_نص_على_زر(رس, خ, "8", زر_8, لون_ابيض);
            ارسم_نص_على_زر(رس, خ, "9", زر_9, لون_ابيض);
            ارسم_نص_على_زر(رس, خ, "÷", زر_قسمة, لون_ابيض);
            
            ارسم_نص_على_زر(رس, خ, "4", زر_4, لون_ابيض);
            ارسم_نص_على_زر(رس, خ, "5", زر_5, لون_ابيض);
            ارسم_نص_على_زر(رس, خ, "6", زر_6, لون_ابيض);
            ارسم_نص_على_زر(رس, خ, "×", زر_ضرب, لون_ابيض);
            
            ارسم_نص_على_زر(رس, خ, "1", زر_1, لون_ابيض);
            ارسم_نص_على_زر(رس, خ, "2", زر_2, لون_ابيض);
            ارسم_نص_على_زر(رس, خ, "3", زر_3, لون_ابيض);
            ارسم_نص_على_زر(رس, خ, "-", زر_طرح, لون_ابيض);
            
            ارسم_نص_على_زر(رس, خ, "0", زر_0, لون_ابيض);
            ارسم_نص_على_زر(رس, خ, ".", زر_فاصلة, لون_ابيض);
            ارسم_نص_على_زر(رس, خ, "C", زر_مسح, لون_ابيض);
            ارسم_نص_على_زر(رس, خ, "+", زر_جمع, لون_ابيض);
            
            ارسم_نص_على_زر(رس, خ, "=", زر_مساواة, لون_ابيض);
        }

        // إطارات الأزرار
        استعمل_لون(رس, 150, 150, 200);
        ارسم_مستطيل_فارغ(رس, &زر_7);
        ارسم_مستطيل_فارغ(رس, &زر_8);
        ارسم_مستطيل_فارغ(رس, &زر_9);
        ارسم_مستطيل_فارغ(رس, &زر_قسمة);
        ارسم_مستطيل_فارغ(رس, &زر_4);
        ارسم_مستطيل_فارغ(رس, &زر_5);
        ارسم_مستطيل_فارغ(رس, &زر_6);
        ارسم_مستطيل_فارغ(رس, &زر_ضرب);
        ارسم_مستطيل_فارغ(رس, &زر_1);
        ارسم_مستطيل_فارغ(رس, &زر_2);
        ارسم_مستطيل_فارغ(رس, &زر_3);
        ارسم_مستطيل_فارغ(رس, &زر_طرح);
        ارسم_مستطيل_فارغ(رس, &زر_0);
        ارسم_مستطيل_فارغ(رس, &زر_فاصلة);
        ارسم_مستطيل_فارغ(رس, &زر_مسح);
        ارسم_مستطيل_فارغ(رس, &زر_جمع);
        ارسم_مستطيل_فارغ(رس, &زر_مساواة);

        اظهر_اللوحة(رس);
        انتظر(16);
    }

    // تنظيف
    اذا (خ != فارغ) اغلق_خط(خ);
    اغلق_راسم(رس);
    اغلق_نافذة(نو);
    اختم_الخط();
    اختم_الرسوم();
    ارجع نجاح;
}
